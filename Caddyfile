{
    servers {
        protocols h1
    }
}

https://xuyinji.com.cn, https://www.xuyinji.com.cn {
    # v5.26 配对二维码中转：主站可信短链 /note/<笔记名> → 302 → note.xuyinji.com.cn/<笔记名>。
    # 小米等系统相机只在扫码瞬间校验二维码内的 URL，用可信主站干净短链规避其对
    # note 子域 + 高熵 #k= 片段的网址安全拦截（承接 v5.22/v5.23 的 bridge 中转方案）。
    # handle_path 剥掉 /note 前缀，{path} 即笔记路径；#k= 片段不发往服务器，
    # 302 后由浏览器自动拼回，密钥零知识模型不变。目标写死为本站 note 子域，非开放重定向。
    handle_path /note/* {
        redir https://note.xuyinji.com.cn{path} 302
    }

    root * C:/Services/xuyinji
    file_server
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @html path /index.html /
    header @html Cache-Control "no-cache, no-store, must-revalidate"
}

https://note.xuyinji.com.cn {
    reverse_proxy /api/note/*/stream 127.0.0.1:8080 {
        transport http {
            keepalive off
        }
        flush_interval -1
    }
    @html path /index.html /
    header @html Cache-Control "no-cache, no-store, must-revalidate"
}

https://520.xuyinji.com.cn {
    root * C:/Services/520
    file_server
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @html path /index.html /
    header @html Cache-Control "no-cache, no-store, must-revalidate"
}
