{
    email admin@xuyinji.com.cn
    storage file_system {
        root C:/Services/Caddy/data
    }
    servers {
        protocols h1
    }
}
https://xuyinji.com.cn, https://www.xuyinji.com.cn {
    # v5.26 NoteSync pairing short link: /note/<id> -> 302 -> note.xuyinji.com.cn/<id>
    handle_path /note/* {
        redir https://note.xuyinji.com.cn{path} 302
    }

    root * C:/Services/xuyinji
    file_server
    encode gzip
    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @html path /index.html /
    header @html Cache-Control "no-cache, no-store, must-revalidate"
}

https://note.xuyinji.com.cn {
    reverse_proxy /api/note/*/stream 127.0.0.1:8080 {
        transport http {
            keepalive off
        }
        flush_interval -1
    }
    reverse_proxy 127.0.0.1:8080
    encode gzip
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' cdn.jsdelivr.net; style-src 'unsafe-inline'; img-src 'self' https://res.cloudinary.com data:; connect-src 'self' https://api.cloudinary.com; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @html path /index.html /
    header @html Cache-Control "no-cache, no-store, must-revalidate"
}

